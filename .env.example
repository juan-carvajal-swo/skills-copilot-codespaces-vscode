# Azure External ID (CIAM) Configuration
# Copy this file to .env and fill in your values

# Azure External ID tenant information
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-app-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure External ID authority URL
# Format: https://<tenant-name>.ciamlogin.com/<tenant-id>
AZURE_AUTHORITY=https://your-tenant-name.ciamlogin.com/your-tenant-id

# Redirect URI registered in Azure External ID app registration
REDIRECT_URI=http://localhost:3000/auth/callback

# Logout redirect URI
POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# API Scopes (space-separated)
API_SCOPES=openid profile email offline_access

# Session configuration
SESSION_SECRET=your-secure-session-secret-change-in-production
SESSION_MAX_AGE_MS=3600000

# Server port
PORT=3000

# JWKS URI for token validation
# Format: https://<tenant-name>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
JWKS_URI=https://your-tenant-name.ciamlogin.com/your-tenant-id/discovery/v2.0/keys
